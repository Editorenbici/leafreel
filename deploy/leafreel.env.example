# LeafReel settings for the two-node recipe. Copy to ~/.config/leafreel.env and edit.
# --- Node A (brain): LLM with vision + this app -------------------------------------------------
LLM_BASE_URL=http://127.0.0.1:8090/v1
LLM_MODEL=Qwen3.8-Flash-Next
# --- Node B (studio): ComfyUI behind comfy-api-proxy ---------------------------------------------
COMFY_BASE_URL=http://studio:8189
COMFY_API_KEY=change-me-same-as-the-proxy-token
COMFY_DIRECT_URL=http://studio:8188      # optional, only for `leafreel doctor` model checks
# --- Narration (Qwen3-TTS on node B over ssh, or any OpenAI-compatible TTS server) ----------------
TTS_BACKEND=qwen3tts
TTS_SSH=user@studio
TTS_PYTHON=/home/user/venvs/qwen3tts/bin/python
# --- Code-rendered styles ---------------------------------------------------------------------------
CHROMIUM_PATH=/usr/bin/chromium
NODE_BIN=/usr/bin/node
# --- Long LTX runs on a hot GPU: pause between clips -----------------------------------------------
# GPU_COOLDOWN=40
