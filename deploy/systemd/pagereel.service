# Node A (brain). The PageReel web app.
[Unit]
Description=PageReel web app
After=network-online.target

[Service]
WorkingDirectory=%h/pagereel
EnvironmentFile=%h/.config/pagereel.env
ExecStart=%h/pagereel/.venv/bin/pagereel serve --host 0.0.0.0 --port 8100
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
