# Node A (brain). The LeafReel web app.
[Unit]
Description=LeafReel web app
After=network-online.target

[Service]
WorkingDirectory=%h/leafreel
EnvironmentFile=%h/.config/leafreel.env
ExecStart=%h/leafreel/.venv/bin/leafreel serve --host 0.0.0.0 --port 8100
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
